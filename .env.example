# ==============================================================================
# CONNECTION QUEST - POSTGRESQL & REAL-TIME WEBSOCKET CONFIGURATION
# ==============================================================================
# Dapatkan kredensial ini dari dashboard PostgreSQL / Supabase Anda:
# 1. Buka https://supabase.com -> Buat / Pilih Project
# 2. Buka Project Settings -> API
# 3. Salin 'Project URL' dan 'anon public' key ke bawah ini:

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
